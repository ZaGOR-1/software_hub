# Application metadata
SOFTWARE_HUB_APP_NAME=Software Hub
SOFTWARE_HUB_APP_VERSION=1.0.0-rc.2
SOFTWARE_HUB_APP_ENVIRONMENT=development
SOFTWARE_HUB_APP_DEBUG=false
SOFTWARE_HUB_DOCS_ENABLED=true

# Required in production. Generate separate high-entropy values of at least 32 characters.
# SOFTWARE_HUB_APP_SECRET_KEY=replace-with-a-generated-secret
# SOFTWARE_HUB_CSRF_SECRET=replace-with-a-different-generated-secret

# CSRF protection
SOFTWARE_HUB_CSRF_FORM_FIELD_NAME=csrf_token
SOFTWARE_HUB_CSRF_HEADER_NAME=X-CSRF-Token
SOFTWARE_HUB_CSRF_TOKEN_TTL_SECONDS=7200
SOFTWARE_HUB_CSRF_TOKEN_MAX_LENGTH=512
SOFTWARE_HUB_LOGIN_CSRF_COOKIE_NAME=software_hub_login_csrf
SOFTWARE_HUB_LOGIN_CSRF_COOKIE_PATH=/admin/login
SOFTWARE_HUB_LOGIN_CSRF_COOKIE_SAME_SITE=strict
SOFTWARE_HUB_LOGIN_CSRF_TTL_SECONDS=600

# Administrator authentication and server-side sessions
# One-time CLI input only; do not keep this variable in the application .env:
# SOFTWARE_HUB_ADMIN_PASSWORD=provide-temporarily-when-running-admin-cli
SOFTWARE_HUB_SESSION_COOKIE_NAME=software_hub_session
SOFTWARE_HUB_SESSION_COOKIE_PATH=/
SOFTWARE_HUB_SESSION_COOKIE_SAME_SITE=lax
# Leave unset to enable automatically in production; set true for local HTTPS.
# SOFTWARE_HUB_SESSION_COOKIE_SECURE=true
SOFTWARE_HUB_SESSION_IDLE_TIMEOUT_SECONDS=1800
SOFTWARE_HUB_SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
SOFTWARE_HUB_SESSION_TOUCH_INTERVAL_SECONDS=60
SOFTWARE_HUB_LOGIN_MAX_FAILED_ATTEMPTS=5
SOFTWARE_HUB_LOGIN_LOCKOUT_SECONDS=900
SOFTWARE_HUB_PASSWORD_MIN_LENGTH=12
SOFTWARE_HUB_PASSWORD_MAX_LENGTH=1024
SOFTWARE_HUB_ARGON2_TIME_COST=3
SOFTWARE_HUB_ARGON2_MEMORY_COST_KIB=65536
SOFTWARE_HUB_ARGON2_PARALLELISM=4

# Database. Production must use an absolute SQLite path on persistent storage.
SOFTWARE_HUB_DATABASE_URL=sqlite+pysqlite:////srv/software-hub/database/software-hub.db
SOFTWARE_HUB_DATABASE_ECHO=false
SOFTWARE_HUB_SQLITE_BUSY_TIMEOUT_MS=5000
SOFTWARE_HUB_SQLITE_SYNCHRONOUS_MODE=NORMAL

# Public URL and reverse-proxy trust
SOFTWARE_HUB_PUBLIC_BASE_URL=http://localhost:8000
SOFTWARE_HUB_INTERNAL_DOWNLOAD_PREFIX=/protected-downloads/
SOFTWARE_HUB_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
SOFTWARE_HUB_TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128

# Persistent and temporary paths must be absolute
SOFTWARE_HUB_STORAGE_ROOT=/srv/software-hub/storage
SOFTWARE_HUB_TEMPORARY_ROOT=/srv/software-hub/storage/temporary
SOFTWARE_HUB_QUARANTINE_ROOT=/srv/software-hub/storage/quarantine
SOFTWARE_HUB_ICONS_ROOT=/srv/software-hub/storage/icons
SOFTWARE_HUB_BACKUP_ROOT=/srv/software-hub/backups
# Keep this reserve available after accepting a file operation.
SOFTWARE_HUB_STORAGE_MIN_FREE_BYTES=1073741824
# Generated temporary .upload files older than this may be cleaned.
SOFTWARE_HUB_TEMPORARY_FILE_MAX_AGE_SECONDS=86400

# Upload policy. 2147483648 bytes = 2 GiB.
SOFTWARE_HUB_MAX_UPLOAD_SIZE=2147483648
SOFTWARE_HUB_ALLOWED_EXTENSIONS=.exe,.msi,.zip,.7z

# Logging and HTTP hardening
SOFTWARE_HUB_LOG_LEVEL=INFO
SOFTWARE_HUB_LOG_JSON=true
SOFTWARE_HUB_REQUEST_ID_HEADER=X-Request-ID
SOFTWARE_HUB_REQUEST_ID_MAX_LENGTH=128
SOFTWARE_HUB_SECURITY_HEADERS_ENABLED=true

# Phase 10 upload pipeline
SOFTWARE_HUB_UPLOAD_CHUNK_SIZE=1048576
SOFTWARE_HUB_UPLOAD_MAGIC_SAMPLE_SIZE=1048576
SOFTWARE_HUB_CLAMAV_ENABLED=false
SOFTWARE_HUB_CLAMAV_COMMAND=clamscan
SOFTWARE_HUB_CLAMAV_TIMEOUT_SECONDS=120

# Backup and retention
SOFTWARE_HUB_BACKUP_RETENTION_COUNT=14
SOFTWARE_HUB_BACKUP_MIN_FREE_BYTES=1073741824
