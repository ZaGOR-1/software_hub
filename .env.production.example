# Docker Compose host/deployment controls. Copy to a private deployment env file.
SOFTWARE_HUB_DATA_ROOT=/srv/software-hub
SOFTWARE_HUB_ENV_FILE=.env.production
SOFTWARE_HUB_DOMAIN=software.hotzagor.tech
SOFTWARE_HUB_HTTP_BIND=0.0.0.0
SOFTWARE_HUB_HTTP_PORT=80
SOFTWARE_HUB_HTTPS_BIND=0.0.0.0
SOFTWARE_HUB_HTTPS_PORT=443
SOFTWARE_HUB_ADMIN_ACCESS_CONF=./nginx/snippets/admin-access-deny.conf
SOFTWARE_HUB_UID=10001
SOFTWARE_HUB_GID=10001
SOFTWARE_HUB_BACKEND_SUBNET=172.30.0.0/24
SOFTWARE_HUB_NGINX_IP=172.30.0.10
SOFTWARE_HUB_APP_IP=172.30.0.20

# Application settings consumed by the app service.
SOFTWARE_HUB_APP_NAME=Software Hub
SOFTWARE_HUB_APP_VERSION=1.0.0-rc.2
SOFTWARE_HUB_APP_ENVIRONMENT=production
SOFTWARE_HUB_APP_DEBUG=false
SOFTWARE_HUB_DOCS_ENABLED=false
SOFTWARE_HUB_APP_SECRET_KEY=replace-with-a-generated-secret-of-at-least-32-characters
SOFTWARE_HUB_CSRF_SECRET=replace-with-a-different-generated-secret-of-at-least-32-characters
SOFTWARE_HUB_PUBLIC_BASE_URL=https://software.hotzagor.tech
SOFTWARE_HUB_TRUSTED_HOSTS=software.hotzagor.tech
SOFTWARE_HUB_SESSION_COOKIE_SECURE=true
SOFTWARE_HUB_DATABASE_URL=sqlite+pysqlite:////srv/software-hub/database/software-hub.db
SOFTWARE_HUB_STORAGE_ROOT=/srv/software-hub/storage
SOFTWARE_HUB_TEMPORARY_ROOT=/srv/software-hub/storage/temporary
SOFTWARE_HUB_QUARANTINE_ROOT=/srv/software-hub/storage/quarantine
SOFTWARE_HUB_ICONS_ROOT=/srv/software-hub/storage/icons
SOFTWARE_HUB_BACKUP_ROOT=/srv/software-hub/backups
SOFTWARE_HUB_SECURITY_HEADERS_ENABLED=false
SOFTWARE_HUB_LOG_JSON=true
SOFTWARE_HUB_LOG_LEVEL=INFO
